# ==============================================================================
# AEGIS Security Platform — .gitignore
# ==============================================================================

# ─── Environment & Secrets ──────────────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.cert

# ─── Python & Backend ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.installed.cfg
*.egg
build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Local Database Files (All data resides directly in Neon PostgreSQL)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ─── Node & Frontend ─────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.oxlint-cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── IDE & System Files ──────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── Temporary & Agent Tool Files ────────────────────────────────────────────
scratch/
.agents/
skills-lock.json
