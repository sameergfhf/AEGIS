# API Sentinel Backend — Environment Variables
# Copy this file to .env and fill in your values.

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-secure-random-secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./api_sentinel.db

# ── Scanner Limits ─────────────────────────────────────────────────────────────
SCAN_LATENCY_SAMPLES=5
MAX_RESPONSE_BYTES=524288        # 512 KB
REQUEST_TIMEOUT_SECONDS=15
MAX_REDIRECTS=5
MAX_CONCURRENT_SCANS=10
SCAN_RATE_LIMIT_PER_MINUTE=20

# ── Reputation / Threat Intelligence ──────────────────────────────────────────
VIRUSTOTAL_API_KEY=                # Leave blank to disable VT lookups
GOOGLE_SAFE_BROWSING_API_KEY=      # Leave blank to disable GSB lookups

# ── Report ─────────────────────────────────────────────────────────────────────
REPORT_RETENTION_DAYS=30

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://sjgqmjsszlvimafqwdpi.supabase.co
SUPABASE_AUTH_URL=https://sjgqmjsszlvimafqwdpi.supabase.co
SUPABASE_AUTH_ANON_KEY=<publishable-key-for-sjgqmjsszlvimafqwdpi>
SUPABASE_WORKSPACE_SERVICE_ROLE_KEY=<server-only-secret-for-sjgqmjsszlvimafqwdpi>
# Set only when the project still signs access tokens with the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=300
# Optional OpenAI-compatible AI provider. Only redacted finding evidence is sent.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
