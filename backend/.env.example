# API Sentinel Backend — Environment Variables
# Copy this file to .env and fill in your values.

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-secure-random-secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# ── Database (Neon Serverless PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://neondb_owner:<password>@ep-xxx-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?ssl=require

# ── Scanner Limits ─────────────────────────────────────────────────────────────
SCAN_LATENCY_SAMPLES=5
MAX_RESPONSE_BYTES=524288        # 512 KB
REQUEST_TIMEOUT_SECONDS=15
MAX_REDIRECTS=5
MAX_CONCURRENT_SCANS=10
SCAN_RATE_LIMIT_PER_MINUTE=20

# ── Reputation / Threat Intelligence ──────────────────────────────────────────
VIRUSTOTAL_API_KEY=                # Leave blank to disable VT lookups
GOOGLE_SAFE_BROWSING_API_KEY=      # Leave blank to disable GSB lookups

# ── Report ─────────────────────────────────────────────────────────────────────
REPORT_RETENTION_DAYS=30

# ── OAuth & Authentication ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# ── Optional AI Intelligence Provider ─────────────────────────────────────────
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
